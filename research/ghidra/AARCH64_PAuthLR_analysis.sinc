# Analysis-only FEAT_PAuth_LR subset used by this 24B119 image.
# Encodings cross-checked against LLVM llvm/test/MC/AArch64/armv9.5a-pauthlr.s.
# Opaque, non-clobbering PAC userops preserve normal successful-return control
# flow. This is NOT a PAC emulator: authentication failure/traps and pointer
# signature bits are not modelled. No firmware bytes are patched.
define pcodeop SignReturnAddressWithPC;
define pcodeop AuthenticateReturnAddressWithPC;
pauth_lr_label: label is imm16 [ label = inst_start - (imm16 << 2); ] { export *[const]:8 label; }
:paciasppc is b_0031=0xdac1a3fe { local place:8=inst_start; local key:1=0; SignReturnAddressWithPC(x30, sp, place, key); }
:pacibsppc is b_0031=0xdac1a7fe { local place:8=inst_start; local key:1=1; SignReturnAddressWithPC(x30, sp, place, key); }
:autiasppc pauth_lr_label is b_2131=0x79c & b_0004=31 & pauth_lr_label { AuthenticateReturnAddressWithPC(x30, sp, pauth_lr_label, 0:1); }
:autibsppc pauth_lr_label is b_2131=0x79d & b_0004=31 & pauth_lr_label { AuthenticateReturnAddressWithPC(x30, sp, pauth_lr_label, 1:1); }
:retaasppc pauth_lr_label is b_2131=0x2a8 & b_0004=31 & pauth_lr_label { AuthenticateReturnAddressWithPC(x30, sp, pauth_lr_label, 0:1); pc=x30; return [pc]; }
:retabsppc pauth_lr_label is b_2131=0x2a9 & b_0004=31 & pauth_lr_label { AuthenticateReturnAddressWithPC(x30, sp, pauth_lr_label, 1:1); pc=x30; return [pc]; }

# FEAT_CPA ADDPT/SUBPT: opaque checked pointer arithmetic, not tag emulation.
# LLVM llvm/test/MC/AArch64/armv9.5a-cpa.s supplies the encoding cross-check.
define pcodeop CheckedPointerAdd;
define pcodeop CheckedPointerSubtract;
:addpt Rd_GPR64xsp, Rn_GPR64xsp, Rm_GPR64, "lsl #"b_1012
is b_2131=0x4d0 & b_1315=1 & b_1012 & Rd_GPR64xsp & Rn_GPR64xsp & Rm_GPR64 { local offset:8=Rm_GPR64 << b_1012; Rd_GPR64xsp=CheckedPointerAdd(Rn_GPR64xsp,offset); }
:subpt Rd_GPR64xsp, Rn_GPR64xsp, Rm_GPR64, "lsl #"b_1012
is b_2131=0x6d0 & b_1315=1 & b_1012 & Rd_GPR64xsp & Rn_GPR64xsp & Rm_GPR64 { local offset:8=Rm_GPR64 << b_1012; Rd_GPR64xsp=CheckedPointerSubtract(Rn_GPR64xsp,offset); }
